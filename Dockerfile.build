# syntax=docker/dockerfile:1.7
# Builds, tests and lints every service on any host.
#   docker build --target check .                                 runs scripts/check.sh
#   docker build --target artifacts --output type=local,dest=dist .   Linux + Windows + Lambda into ./dist
ARG GO_IMAGE=golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0

FROM ${GO_IMAGE} AS tools
COPY scripts/tools.env /tmp/tools.env
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc pkg-config libwebkit2gtk-4.1-dev libgtk-3-dev xvfb zip shellcheck python3 \
 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    . /tmp/tools.env \
 && go install "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}" \
 && go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}" \
 && go install "github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION}" \
 && go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}"
ENV GOFLAGS=-buildvcs=false
WORKDIR /src

FROM tools AS check
COPY . .
RUN scripts/check.sh ./...

FROM tools AS dist
COPY . .
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    scripts/build-all.sh "$VERSION"

FROM scratch AS artifacts
COPY --from=dist /src/dist/ /
